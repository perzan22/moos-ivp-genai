//-------------------------------------------------
// NAME: Mission for GAN training
// FILE: alpha.moos
//-------------------------------------------------

ServerHost   = localhost
ServerPort   = 9000
Community    = alpha
MOOSTimeWarp = 1

// Forest Lake
LatOrigin  = 43.825300 
LongOrigin = -70.330400 

//------------------------------------------
// Antler configuration  block
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB        @ NewConsole = false
  Run = pLogger       @ NewConsole = false
  Run = uSimMarineV22 @ NewConsole = false
  Run = pMarinePIDV22 @ NewConsole = false
  Run = pHelmIvP      @ NewConsole = false
  // Run = pMarineViewer	@ NewConsole = false
  Run = pNodeReporter	@ NewConsole = false
  Run = uTimerScript  @ NewConsole = false
}

//------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AppTick   = 8
  CommsTick = 8

  AsyncLog = true
  WildCardLogging = false

  // Pozycja i ruch
  Log = RUN_ID        @ 0
  Log = NAV_X         @ 0
  Log = NAV_Y         @ 0
  Log = NAV_HEADING   @ 0

  // Warunki środowiskowe
  Log = DRIFT_VECTOR @ 0

  // PID metadata
  Log = YAW_KP             @ 0
  Log = YAW_KI             @ 0
  Log = YAW_KD             @ 0
  Log = YAW_ILIM           @ 0

  Log = SPD_KP             @ 0
  Log = SPD_KI             @ 0
  Log = SPD_KD             @ 0
  Log = SPD_ILIM           @ 0

  Log = DEPLOY             @ 0
  Log = RETURN             @ 0
  Log = MISSION            @ 0
}

//------------------------------------------
// uSimMarineV22 config block

ProcessConfig = uSimMarineV22
{
  AppTick  	= 4
  CommsTick	= 4

  start_pos     = x={{START_X}}, y={{START_Y}}, heading={{START_HEADING}}, speed=0
  prefix        = NAV
  turn_rate     = 95
  thrust_map    = 0:0, 20:1, 40:2, 60:3, 80:4, 100:5
	turn_spd_loss = 0.4

  // symulacja wiatru prdu, jako drift_vector
  drift_vector = {{DRIFT_ANGLE}},{{DRIFT_SPEED}}
}

//------------------------------------------
// pHelmIvP config block

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  behaviors  = alpha.bhv
  domain     = course:0:359:360
  domain     = speed:0:4:41

  verbose = false
}

//------------------------------------------
// pMarinePID config block

ProcessConfig = pMarinePIDV22
{
  AppTick    = 20
  CommsTick  = 20

  verbose       = false
  depth_control = false

  yaw_pid_kp = {{YAW_KP}}
  yaw_pid_ki = {{YAW_KI}}
  yaw_pid_kd = {{YAW_KD}}
  yaw_pid_integral_limit = {{YAW_ILIM}}

  speed_pid_kp = {{SPD_KP}}
  speed_pid_ki = {{SPD_KI}}
  speed_pid_kd = {{SPD_KD}}
  speed_pid_integral_limit = {{SPD_ILIM}}

  maxrudder    = {{MAXRUDDER}}
  maxthrust    = {{MAXTHRUST}}

  // A non-zero SPEED_FACTOR overrides use of SPEED_PID
  // Will set DESIRED_THRUST = DESIRED_SPEED * SPEED_FACTOR
  speed_factor = {{SPEED_FACTOR}}
}

//------------------------------------------
// pMarineViewer config block

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = forrest19.tif

  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicle_shape_scale  = 1.5
  hash_delta           = 50
  hash_shade           = 0.22
  hash_viewable        = true

  trails_point_size   = 1

  // Appcast configuration
  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = xlarge
  procs_font_size      = xlarge
  appcast_font_size    = large


  right_context[return] = DEPLOY=true
  right_context[return] = MOOS_MANUAL_OVERRIDE=false
  right_context[return] = RETURN=false

  scope  = DEPLOY
  scope  = RETURN
  scope  = MOOS_MANUAL_OVERRIDE
  scope  = NAV_X
  scope  = NAV_Y

  button_one = DEPLOY # DEPLOY=true
  button_one = MOOS_MANUAL_OVERRIDE=false # RETURN=false
  button_two = RETURN # RETURN=true

  action  = MENU_KEY=deploy # DEPLOY = true # RETURN = false
  action+ = MENU_KEY=deploy # MOOS_MANUAL_OVERRIDE=false
  action  = RETURN=true
  action  = UPDATES_RETURN=speed=1.4
}

//------------------------------------------
// pNodeReporter config block

ProcessConfig = pNodeReporter
{
  AppTick    = 2
  CommsTick	 = 2

  platform_type   = kayak
  platform_color  = yellow
  platform_length = 4
}

ProcessConfig = uTimerScript
{
  AppTick   = 1
  CommsTick = 1
  reset_max = 0

  event = var=RUN_ID, val="{{RUN_ID}}", time=0

  event = var=DRIFT_VECTOR, val="{{DRIFT_ANGLE}},{{DRIFT_SPEED}}", time=0

  event = var=YAW_KP, val="{{YAW_KP}}", time=0
  event = var=YAW_KI, val="{{YAW_KI}}", time=0
  event = var=YAW_KD, val="{{YAW_KD}}", time=0
  event = var=YAW_ILIM, val="{{YAW_ILIM}}", time=0

  event = var=SPD_KP, val="{{SPD_KP}}", time=0
  event = var=SPD_KI, val="{{SPD_KI}}", time=0
  event = var=SPD_KD, val="{{SPD_KD}}", time=0
  event = var=SPD_ILIM, val="{{SPD_ILIM}}", time=0

  event = var=MOOS_MANUAL_OVERRIDE, val=false, time=1
  event = var=DEPLOY, val=true, time=1
}

